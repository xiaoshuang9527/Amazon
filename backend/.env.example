# ============================================================
# 亚马逊 Listing 多语言文案生成工具 —— 后端环境变量示例
# 复制为 .env 后按需修改；严禁把真实密钥提交到版本库
# ============================================================

# ---- 基础 ----
APP_NAME=亚马逊 Listing 多语言文案生成工具
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# CORS 白名单（JSON 数组格式，前端开发端口 5180 / 生产 8080）
CORS_ORIGINS=["http://localhost:5180","http://localhost:8080"]

# ---- 数据库（PostgreSQL 15；本地直连时把 host 换成 localhost）----
DATABASE_URL=postgresql+psycopg2://listing:listing@postgres:5432/listing
SQL_ECHO=false

# ---- 安全 ----
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Fernet 对称加密密钥（加密存储 SP-API refresh_token）
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ---- Amazon SP-API（MVP 可选，留空则仅走手动粘贴 + 导出）----
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=
SPAPI_LWA_ENDPOINT=https://api.amazon.com/auth/o2/token
SPAPI_AUTH_BASE=https://sellercentral.amazon.com/apps/authorize/consent
SPAPI_REDIRECT_URI=http://localhost:8000/api/v1/auth/spapi/callback

# ---- LLM 网关（统一入口，禁止在业务代码里直连模型）----
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_STANDARD=deepseek-chat
LLM_MODEL_HIGH=deepseek-reasoner
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_ENABLE_CACHE=true

# ---- 外部调用速率控制（令牌桶 + 指数退避）----
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=5
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=8

# ---- 计费 / 配额 ----
FREE_MONTHLY_QUOTA=3
BASIC_MONTHLY_QUOTA=50
PRO_MONTHLY_QUOTA=200

# ---- 任务调度与日志 ----
ENABLE_SCHEDULER=true
LOG_DIR=logs
LOG_LEVEL=INFO

# ---- 管理后台 ----
# 设置后，使用该邮箱注册的用户会自动成为管理员（用于引导第一个管理员）。
# 留空表示不自动提升，改用 CLI：python -m app.cli create-admin --email x@y.com --password secret123
BOOTSTRAP_ADMIN_EMAIL=
